# =========================================================
# SCM Configuration: .gitignore
# Online Book Store Application
# =========================================================

# Dependencies
node_modules/
package-lock.json
vendor/

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv
env/
venv/
ENV/

# Build artifacts & distribution
dist/
build/
*.egg-info/

# Logs & Runtime Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# SCM Temporary Snapshots & Backups
*.zip
*.tar.gz
*.bak

# IDE & OS Specific
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# SCM Internal engine cache (if needed)
.pyscm_temp/
